{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3650,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(git:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh diff:*)",
      "Bash(gh release view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(docker compose logs:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -f:*)",
      "Bash(rm --force:*)",
      "Bash(git clone:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git commit -a:*)",
      "Bash(git commit --all:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(git push -u:*)",
      "Bash(git push --set-upstream:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove -f:*)",
      "Bash(git worktree remove --force:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh auth:*)",
      "Bash(gh gist:*)",
      "Bash(gh gpg-key:*)",
      "Bash(gh secret:*)",
      "Bash(gh ssh-key:*)",
      "Read(id_*)",
      "Read(credentials)",
      "Read(.credentials.json)",
      "Read(.env*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(nc:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/auto-resume/recorder.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline/main.ts"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754032915018
  },
  "model": "claude-fable-5[1m]",
  "fallbackModel": ["claude-sonnet-5"]
}
